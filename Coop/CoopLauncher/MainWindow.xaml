<Window x:Class="CoopGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoopGameLauncher"
        Title="{x:Static local:LauncherVersionInfo.WindowTitle}"
        Height="520"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="런처 저장 경로 바로가기" Click="MenuOpenLauncherFolder_Click" />
                <MenuItem Header="종료(_X)" Click="MenuExit_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,8,10,4">
                <TextBlock Text="빌드 타입:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbBuildType"
                          Width="130"
                          SelectedIndex="0"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Development" />
                    <ComboBoxItem Content="Shipping" />
                </ComboBox>

                <TextBlock Width="20" />

                <Button x:Name="BtnRefreshFromServer"
                        Content="빌드목록 새로고침"
                        Width="140"
                        Margin="0,0,8,0"
                        Click="BtnRefreshFromServer_Click" />

                <Button x:Name="BtnRun"
                        Content="게임 실행"
                        Width="80"
                        Margin="0,0,8,0"
                        Click="BtnRun_Click" />

                <CheckBox x:Name="CbWindowed"
                          Content="창모드"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />

                <TextBlock Text="│"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0" />

                <CheckBox x:Name="CbRunClient"
                          Content="클라이언트"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <CheckBox x:Name="CbRunDS"
                          Content="DS"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,4">
                <TextBlock Text="진행율:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ProgressBar x:Name="PbGameStarter" Width="240" Height="18" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtGameStarterProgress" VerticalAlignment="Center" MinWidth="280" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10,0,10,4">
                <TextBlock Text="로컬 캐시 경로:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtCachePath"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="BtnChangeCachePath" Content="캐시 경로 변경" Width="120" Height="24" Margin="12,0,0,0"
                        Click="MenuChangeCachePath_Click"/>
                <Button x:Name="BtnClearCache" Content="캐시 삭제" Width="90" Height="24" Margin="8,0,0,0"
                        Click="MenuClearCache_Click"/>
                <Button x:Name="BtnOpenCachePath" Content="바로가기" Width="70" Height="24" Margin="8,0,0,0"
                        Click="BtnOpenCachePath_Click"/>
            </StackPanel>

            <ListView x:Name="LvBuilds"
                      Grid.Row="3"
                      Margin="10,0,10,10"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                                  Path=IsSelected,
                                                                  Mode=TwoWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="BuildNo." Width="80" DisplayMemberBinding="{Binding BuildNo}" />
                        <GridViewColumn Header="Version" Width="100" DisplayMemberBinding="{Binding Version}" />
                        <GridViewColumn Header="CL" Width="80" DisplayMemberBinding="{Binding CL}" />
                        <GridViewColumn Header="Config" Width="100" DisplayMemberBinding="{Binding Config}" />
                        <GridViewColumn Header="Date" Width="120" DisplayMemberBinding="{Binding BuildDate}" />
                        <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding BuildTime}" />
                        <GridViewColumn Header="DS" Width="50" DisplayMemberBinding="{Binding DS}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
