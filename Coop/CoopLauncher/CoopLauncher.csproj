<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\GWLauncher\Assets\launcher.ico</ApplicationIcon>
    <AssemblyName>CoopLauncher</AssemblyName>
    <ApplicationTitle>GW Coop Launcher</ApplicationTitle>
    <RootNamespace>CoopGameLauncher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\GWLauncher\DownloadProgressFormatter.cs" Link="DownloadProgressFormatter.cs" />
    <Compile Include="..\..\GWLauncher\GameBuildLauncher.cs" Link="GameBuildLauncher.cs" />
    <Compile Include="..\..\GWLauncher\BuildListService.cs" Link="BuildListService.cs" />
    <Compile Include="..\..\GWLauncher\AppSettings.cs" Link="AppSettings.cs" />
  </ItemGroup>

</Project>
