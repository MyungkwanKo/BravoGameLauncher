<Window x:Class="BravoGameLauncherGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BravoGameLauncherGui"
        Title="{x:Static local:LauncherVersionInfo.WindowTitle}"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:WidthReductionConverter x:Key="WidthReduction"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 공통 헤더: 메뉴 + 위키 링크(항상 고정) -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단 메뉴 (공통) -->
            <Menu Grid.Row="0">
                <MenuItem Header="파일(_F)">
                    <MenuItem Header="런처 저장 경로 바로가기" Click="MenuOpenLauncherFolder_Click" />
                    <MenuItem Header="종료(_X)" Click="MenuExit_Click" />
                </MenuItem>
            </Menu>

            <!-- 상단 고정 Wiki 링크 -->
            <Border Grid.Row="1"
                    Padding="10,6"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://krafton.atlassian.net/wiki/spaces/PROJECTGW/pages/846770135/GW+Launcher"
                            RequestNavigate="Hyperlink_RequestNavigate">
                        [통합런처 사용 가이드 wiki 바로가기]
                    </Hyperlink>
                </TextBlock>
            </Border>
        </Grid>

        <!-- 좌측 탭 메뉴 -->
        <TabControl x:Name="MainLauncherTabs"
                    Grid.Row="1"
                    TabStripPlacement="Left"
                    SelectedIndex="0"
                    Margin="0"
                    SelectionChanged="MainTab_SelectionChanged">

            <!-- 0) GWEditor (통합: Perforce 설정 + Engine + p4 sync/Editor 실행, 접이식 섹션) -->
            <TabItem x:Name="TabItemGWEditor" Header="GW Sync">
                <Grid x:Name="GWSyncOuterGrid" Margin="0">
                    <Grid.RowDefinitions>
                        <!-- 이 행의 실제 Height는 코드비하인드(UpdateGWSyncSectionsRowHeight)에서 매번 계산해 픽셀값으로 지정한다.
                             Grid의 Auto+MaxHeight 조합은 ScrollViewer 자식에게 무한 높이로 측정값을 넘겨버려
                             내용이 넘쳐도 스크롤바가 뜨지 않는 문제가 있어(WPF 알려진 동작), 반드시 고정 픽셀 값을 써야 한다. -->
                        <RowDefinition Height="250"/>
                        <!-- 세션 영역이 줄어들면(접힘) 로그창이 자동으로 커지고, 늘어나면(펼침) 자동으로 작아짐 -->
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GWSyncSectionsPanel" Margin="10">

                    <!-- 섹션: Perforce 설정 -->
                    <Expander x:Name="ExpanderP4Setup" IsExpanded="False" Margin="0,0,0,8"
                              BorderBrush="#DDDDDD" BorderThickness="1" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Border x:Name="P4SectionHeaderBorder" Background="Transparent" CornerRadius="2" HorizontalAlignment="Stretch"
                                    Width="{Binding ActualWidth, ElementName=GWSyncSectionsPanel, Converter={StaticResource WidthReduction}, ConverterParameter=16}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="P4SectionStatusDot" Grid.Column="0" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Perforce 설정" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtP4SectionSummary" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Foreground="#333333" FontSize="13" FontWeight="Medium" Margin="24,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Expander.Header>
                        <Grid Margin="8,10,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Workspace(P4CLIENT):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TbP4Workspace"
                                         Width="220"
                                         Height="24"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <Button x:Name="BtnP4Lookup"
                                        Content="조회"
                                        Width="70"
                                        Height="24"
                                        Margin="0,0,8,0"
                                        Click="BtnP4Lookup_Click"/>
                                <Button x:Name="BtnSetupP4Apply"
                                        Content="적용"
                                        Width="80"
                                        Height="24"
                                        Click="BtnSetupP4Apply_Click"/>
                            </StackPanel>

                            <!-- P4USER 선택 (단일 선택 체크박스) -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="P4USER:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="CbP4UserDeveloper"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Click="CbP4UserDeveloper_Click">
                                    <TextBlock Text="gw_developer"/>
                                </CheckBox>

                                <CheckBox x:Name="CbP4UserEngine"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Click="CbP4UserEngine_Click">
                                    <TextBlock Text="gw_engine"/>
                                </CheckBox>

                                <CheckBox x:Name="CbP4UserGuest"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Click="CbP4UserGuest_Click">
                                    <TextBlock Text="gw_guest"/>
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <!-- 섹션: Engine (Installed Build) -->
                    <Expander x:Name="ExpanderEngine" IsExpanded="False" Margin="0,0,0,8"
                              BorderBrush="#DDDDDD" BorderThickness="1" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Border x:Name="EngineSectionHeaderBorder" Background="Transparent" CornerRadius="2" HorizontalAlignment="Stretch"
                                    Width="{Binding ActualWidth, ElementName=GWSyncSectionsPanel, Converter={StaticResource WidthReduction}, ConverterParameter=16}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="EngineSectionStatusDot" Grid.Column="0" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Engine" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtEngineSectionSummary" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Foreground="#333333" FontSize="13" FontWeight="Medium" Margin="24,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Expander.Header>
                        <Grid Margin="8,10,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- UE 버전은 변경이 거의 없어 드롭다운 없이 UE5.6으로 고정 사용(코드비하인드 _engineVersion 상수값) -->

                            <!-- 설치 경로 (필수: 기본 설치 경로 변경) -->
                            <GroupBox Header="설치 경로" Grid.Row="0" Margin="0,0,0,8">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="BasePath:" Width="90" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TbEngineBasePath" Width="420" Height="24" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnEngineChangePath" Content="변경..." Width="80" Height="24" Margin="8,0,0,0"
                                                Click="BtnEngineChangePath_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="InstallRoot:" Width="90" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TbEngineInstallRoot" Width="510" Height="24" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- 작업 버튼 + 진행 (다운로드 단독 버튼 제거, 다운로드+설치만 유지) -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnEngineRefresh" Content="새로고침" Width="100" Height="28"
                                        Click="BtnEngineRefresh_Click"/>
                                <Button x:Name="BtnEngineDownloadInstall" Content="다운로드 + 설치" Width="140" Height="28" Margin="8,0,0,0"
                                        Click="BtnEngineDownloadInstall_Click"/>
                                <ProgressBar x:Name="PbEngine" Width="240" Height="18" Margin="16,4,0,0"/>
                                <TextBlock x:Name="TxtEngineProgress" Margin="8,4,0,0" VerticalAlignment="Center" MinWidth="160" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <!-- 섹션: GWEditor (기본 펼침) -->
                    <Expander x:Name="ExpanderGWEditor" IsExpanded="True" Margin="0,0,0,8"
                              BorderBrush="#DDDDDD" BorderThickness="1" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Border x:Name="GWEditorSectionHeaderBorder" Background="Transparent" CornerRadius="2" HorizontalAlignment="Stretch"
                                    Width="{Binding ActualWidth, ElementName=GWSyncSectionsPanel, Converter={StaticResource WidthReduction}, ConverterParameter=16}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="GWEditorSectionStatusDot" Grid.Column="0" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="GWEditor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtGWEditorSectionSummary" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Foreground="#333333" FontSize="13" FontWeight="Medium" Margin="24,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Expander.Header>
                <Grid Margin="8,10,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 정보 표시: 라벨(0열) | 값(1열) 세로 목록 (시안 레이아웃: 구분선/우측 버튼 패널 없음) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Workspace(P4CLIENT)는 Perforce 설정 섹션에 이미 표시되므로 중복 제거 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Client stream" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="TbGWEditorClientStream" IsReadOnly="True" Height="26" VerticalAlignment="Center"/>

                        <!-- Editor(UnrealEditor.exe) 경로 행 제거 — 내부적으로만 계산해 실행에 사용(_gwEditorEditorExePath) -->

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Local CL" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="TbGWEditorLocalCL" IsReadOnly="True" Height="26" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Stream Latest CL" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" x:Name="TbGWEditorStreamLatestCL" IsReadOnly="True" Height="26" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="GW_ProjectBuild CL" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox  Grid.Row="3" Grid.Column="1" x:Name="TbGWEditorBuildCL" IsReadOnly="True" Height="26" VerticalAlignment="Center"/>

                        <!-- Sync 필요여부 행 제거 — 섹션 헤더(GWEditorSectionStatusDot·TxtGWEditorSectionSummary)에 이미 표시되어 중복 -->

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="DataTableGenerate CL" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TbGWEditorDataTableGenerateCLs"
                            IsReadOnly="True" Height="26" VerticalAlignment="Center"
                            TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,0"/>
                    </Grid>

                    <!-- 실행 옵션 (에디터 실행 인자) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="실행 옵션:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TbGWEditorArgs" Height="24" VerticalContentAlignment="Center"
                                 Text="-nocompile" MinWidth="280"/>
                        <Button x:Name="BtnGWEditorArgsReset" Content="Reset" Width="60" Height="24" Margin="8,0,0,0"
                                Click="BtnGWEditorArgsReset_Click"/>
                    </StackPanel>

                    <!-- 실행 버튼: 한 줄 (시안 레이아웃) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="BtnGWEditorRefresh" Content="새로고침" Width="100" Margin="0,0,8,0"
                                Click="BtnGWEditorRefresh_Click"/>
                        <Button x:Name="BtnRunGWEditor" Content="Editor실행" Width="100" Margin="0,0,8,0"
                                Click="BtnRunGWEditor_Click"/>
                        <Button x:Name="BtnGWEditorSync" Content="Sync" Width="100" Margin="0,0,8,0"
                                Click="BtnGWEditorSync_Click"/>
                        <Button x:Name="BtnGWEditorDataSync" Content="Data Sync" Width="100" Margin="0,0,8,0"
                                Click="BtnGWEditorDataSync_Click"/>
                        <Button x:Name="BtnGWEditorLocalRollback" Content="Local Rollback" Width="110"
                                Click="BtnGWEditorLocalRollback_Click"/>
                    </StackPanel>
                </Grid>
                    </Expander>

                </StackPanel>
                </ScrollViewer>

                <!-- 통합 로그창: 세션별로 나누지 않고 GWEditor 탭 하단에 공용으로 고정 -->
                <TextBox x:Name="TxtSharedLog"
                        Grid.Row="1"
                        Margin="10,4,10,10"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        AcceptsReturn="True"/>
                </Grid>
            </TabItem>


            <!-- 1) GameStarter (v2 UI 그대로 유지) -->
            <TabItem x:Name="TabItemGameStarter" Header="GameStarter">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 상단 컨트롤 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,8,10,4">
                        <TextBlock Text="빌드 타입:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbBuildType"
                                  Width="130"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Development" />
                            <ComboBoxItem Content="Shipping" />
                        </ComboBox>

                        <TextBlock Width="20" />

                        <Button x:Name="BtnRefreshFromServer"
                                Content="빌드목록 새로고침"
                                Width="140"
                                Margin="0,0,8,0"
                                Click="BtnRefreshFromServer_Click" />

                        <Button x:Name="BtnDownloadBuild"
                                Content="다운로드"
                                Width="80"
                                Margin="0,0,8,0"
                                Click="BtnDownloadBuild_Click" />

                        <Button x:Name="BtnRun"
                                Content="게임 실행"
                                Width="80"
                                Margin="0,0,8,0"
                                Click="BtnRun_Click" />

                        <CheckBox x:Name="CbWindowed"
                                  Content="창모드"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />

                        <!-- 구분선 -->
                        <TextBlock Text="│"
                                VerticalAlignment="Center"
                                Margin="4,0,4,0" />

                        <!-- 실행 대상: 클라이언트 / DS -->
                        <CheckBox x:Name="CbRunClient"
                                  Content="클라이언트"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <CheckBox x:Name="CbRunDS"
                                  Content="DS"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- 다운로드/설치 진행율 (Engine 탭과 동일한 방식) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,4">
                        <TextBlock Text="진행율:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ProgressBar x:Name="PbGameStarter" Width="240" Height="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtGameStarterProgress" VerticalAlignment="Center" MinWidth="280" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 클라이언트 실행 옵션 (GW.exe 인자): Grid로 남은 폭만 사용, 긴 줄은 입력란 내 가로 스크롤 -->
                    <Grid Grid.Row="2" Margin="10,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="클라이언트 실행 옵션:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="TbGameStarterArgs" Height="24" VerticalContentAlignment="Center"
                                 MinWidth="0"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"/>
                        <Button Grid.Column="2" x:Name="BtnGameStarterArgsReset" Content="Reset" Width="60" Height="24" Margin="8,0,0,0"
                                Click="BtnGameStarterArgsReset_Click"/>
                    </Grid>

                    <!-- DS 실행 옵션 (GWServer.exe 인자): 1줄 높이 -->
                    <Grid Grid.Row="3" Margin="10,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DS 실행 옵션:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="TbGameStarterDsArgs" MinHeight="28" Height="28" MinWidth="0"
                                 VerticalContentAlignment="Center"
                                 Text="-port=7778 -MapBaseId=10111 -log -LogCmds=&quot;LogGW Verbose&quot;"
                                 TextWrapping="NoWrap" AcceptsReturn="False"
                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"/>
                        <Button Grid.Column="2" x:Name="BtnGameStarterDsArgsReset" Content="Reset" Width="60" Height="24" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="BtnGameStarterDsArgsReset_Click"/>
                    </Grid>

                    <!-- 캐시 경로 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="10,0,10,4">
                        <TextBlock Text="로컬 캐시 경로:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtCachePath"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="BtnChangeCachePath" Content="캐시 경로 변경" Width="120" Height="24" Margin="12,0,0,0"
                                Click="MenuChangeCachePath_Click"/>
                        <Button x:Name="BtnClearCache" Content="캐시 삭제" Width="90" Height="24" Margin="8,0,0,0"
                                Click="MenuClearCache_Click"/>
                        <Button x:Name="BtnOpenCachePath" Content="바로가기" Width="70" Height="24" Margin="8,0,0,0"
                                Click="BtnOpenCachePath_Click"/>
                        <Button x:Name="BtnSendCrashLog" Content="크래시 로그 전송" Width="130" Height="24" Margin="8,0,0,0"
                                Click="BtnSendCrashLog_Click"/>
                    </StackPanel>

                    <!-- 빌드 리스트: 체크박스 선택 컬럼 + v2 최종 컬럼 (가로 스크롤바 비활성 → 하단 로그와 겹침 방지) -->
                    <ListView x:Name="LvBuilds"
                              Grid.Row="5"
                              Margin="10,0,10,4"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>

                                <!-- v2 방식: 체크박스가 ListViewItem.IsSelected에 바인딩 -->
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                                          Path=IsSelected,
                                                                          Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="BuildNo."
                                                Width="80"
                                                DisplayMemberBinding="{Binding BuildNo}" />
                                <GridViewColumn Header="Version"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Version}" />
                                <GridViewColumn Header="CL"
                                                Width="80"
                                                DisplayMemberBinding="{Binding CL}" />
                                <GridViewColumn Header="Config"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Config}" />
                                <GridViewColumn Header="Date"
                                                Width="120"
                                                DisplayMemberBinding="{Binding BuildDate}" />
                                <GridViewColumn Header="Time"
                                                Width="100"
                                                DisplayMemberBinding="{Binding BuildTime}" />
                                <GridViewColumn Header="클라이언트"
                                                Width="56"
                                                DisplayMemberBinding="{Binding Client}" />
                                <GridViewColumn Header="DS"
                                                Width="50"
                                                DisplayMemberBinding="{Binding DS}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 로그: GameStarter -->
                    <TextBox x:Name="TxtLog"
                             Grid.Row="6"
                             Margin="10,0,10,10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
