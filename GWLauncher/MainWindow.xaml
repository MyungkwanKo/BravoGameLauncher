<Window x:Class="BravoGameLauncherGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GW Launcher"
        Height="450"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 메뉴 (공통) -->
        <Menu Grid.Row="0">
            <MenuItem Header="옵션(_O)">
                <MenuItem Header="캐시 경로 변경..." Click="MenuChangeCachePath_Click" />
                <MenuItem Header="캐시 전체 삭제..." Click="MenuClearCache_Click" />
                <Separator />
                <MenuItem Header="종료(_X)" Click="MenuExit_Click" />
            </MenuItem>
        </Menu>

        <!-- 좌측 탭 메뉴 -->
        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    SelectedIndex="3"
                    Margin="0"
                    SelectionChanged="MainTab_SelectionChanged">

            <!-- 1) Setup_p4 -->
            <TabItem Header="Setup p4">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Perforce 환경변수 설정 (setup_p4)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Workspace(P4CLIENT):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TbP4Workspace"
                                 Width="260"
                                 Height="24"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <Button x:Name="BtnSetupP4Apply"
                                Content="적용"
                                Width="80"
                                Height="24"
                                Click="BtnSetupP4Apply_Click"/>
                    </StackPanel>

                    <!-- 탭별 로그: Setup p4 -->
                    <TextBox x:Name="TxtSetupP4Log"
                             Grid.Row="2"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Grid>
            </TabItem>

            <!-- 2) p4_sync (GUI만 + 탭별 로그 자리 확보) -->
            <TabItem Header="p4 sync">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="(추후 p4_sync 기능 통합 예정)"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,0,0,8" />

                    <!-- 탭별 로그: p4 sync (향후 연결) -->
                    <TextBox x:Name="TxtP4SyncLog"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Grid>
            </TabItem>

            <!-- 3) GWEditor -->
            <TabItem Header="GWEditor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상단: WS/Root 표시 + 버튼 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="Workspace(P4CLIENT)" />
                            <TextBlock Text="Client Root" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBox x:Name="TbGWEditorWorkspace" IsReadOnly="True" />
                            <TextBox x:Name="TbGWEditorClientRoot" IsReadOnly="True" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="BtnGWEditorRefresh"
                                Content="새로고침"
                                Width="90"
                                Margin="10,0,0,0"
                                Click="BtnGWEditorRefresh_Click"/>

                        <Button Grid.Column="3"
                                x:Name="BtnRunGWEditor"
                                Content="실행"
                                Width="80"
                                Margin="8,0,0,0"
                                Click="BtnRunGWEditor_Click"/>
                    </Grid>

                    <!-- 안내 -->
                    <TextBlock Grid.Row="1"
                            Text="Client Root 기준으로 Engine\Binaries\Win64\UnrealEditor.exe 와 GW\GW.uproject 를 찾아 실행합니다."
                            TextWrapping="Wrap"
                            Margin="0,0,0,8"/>

                    <!-- 탭별 로그 -->
                    <TextBox x:Name="TxtGWEditorLog"
                            Grid.Row="2"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            AcceptsReturn="True"/>
                </Grid>
            </TabItem>


            <!-- 4) GameStarter (v2 UI 그대로 유지) -->
            <TabItem Header="GameStarter">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 상단 컨트롤 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,8,10,4">
                        <TextBlock Text="빌드 타입:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbBuildType"
                                  Width="130"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Development" />
                            <ComboBoxItem Content="Shipping" />
                        </ComboBox>

                        <TextBlock Width="20" />

                        <Button x:Name="BtnRefreshFromServer"
                                Content="빌드목록 새로고침"
                                Width="140"
                                Margin="0,0,8,0"
                                Click="BtnRefreshFromServer_Click" />

                        <Button x:Name="BtnRun"
                                Content="실행"
                                Width="80"
                                Margin="0,0,8,0"
                                Click="BtnRun_Click" />

                        <CheckBox x:Name="CbWindowed"
                                  Content="창모드"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- 캐시 경로 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10,0,10,4">
                        <TextBlock Text="로컬 캐시 경로:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtCachePath"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 빌드 리스트: 체크박스 선택 컬럼 + v2 최종 컬럼 -->
                    <ListView x:Name="LvBuilds"
                              Grid.Row="2"
                              Margin="10,0,10,4"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>

                                <!-- v2 방식: 체크박스가 ListViewItem.IsSelected에 바인딩 -->
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                                          Path=IsSelected,
                                                                          Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="BuildNo."
                                                Width="80"
                                                DisplayMemberBinding="{Binding BuildNo}" />
                                <GridViewColumn Header="Version"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Version}" />
                                <GridViewColumn Header="CL"
                                                Width="80"
                                                DisplayMemberBinding="{Binding CL}" />
                                <GridViewColumn Header="Config"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Config}" />
                                <GridViewColumn Header="Date"
                                                Width="120"
                                                DisplayMemberBinding="{Binding BuildDate}" />
                                <GridViewColumn Header="Time"
                                                Width="100"
                                                DisplayMemberBinding="{Binding BuildTime}" />
                                <GridViewColumn Header="DS"
                                                Width="50"
                                                DisplayMemberBinding="{Binding DS}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 로그: GameStarter -->
                    <TextBox x:Name="TxtLog"
                             Grid.Row="3"
                             Margin="10,0,10,10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
