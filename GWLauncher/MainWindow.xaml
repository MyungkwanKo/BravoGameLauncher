<Window x:Class="BravoGameLauncherGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BravoGameLauncherGui"
        Title="{x:Static local:LauncherVersionInfo.WindowTitle}"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 공통 헤더: 메뉴 + 위키 링크(항상 고정) -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단 메뉴 (공통) -->
            <Menu Grid.Row="0">
                <MenuItem Header="파일(_F)">
                    <MenuItem Header="런처 저장 경로 바로가기" Click="MenuOpenLauncherFolder_Click" />
                    <MenuItem Header="종료(_X)" Click="MenuExit_Click" />
                </MenuItem>
            </Menu>

            <!-- 상단 고정 Wiki 링크 -->
            <Border Grid.Row="1"
                    Padding="10,6"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://krafton.atlassian.net/wiki/spaces/PROJECTGW/pages/846770135/GW+Launcher"
                            RequestNavigate="Hyperlink_RequestNavigate">
                        [통합런처 사용 가이드 wiki 바로가기]
                    </Hyperlink>
                </TextBlock>
            </Border>
        </Grid>

        <!-- 좌측 탭 메뉴 -->
        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    SelectedIndex="3"
                    Margin="0"
                    SelectionChanged="MainTab_SelectionChanged">

            <!-- 0) Engine -->
            <TabItem Header="Engine">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- UE 버전 선택 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="UE Version:" Width="90" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbEngineVersion"
                                    Width="160"
                                    Height="24"
                                    VerticalContentAlignment="Center"
                                    SelectionChanged="CbEngineVersion_SelectionChanged"/>
                        </StackPanel>

                        <!-- 설치 경로 -->
                        <GroupBox Header="Installed Build 설치 경로" Grid.Row="1" Margin="0,0,0,8">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="BasePath:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbEngineBasePath" Width="520" Height="24" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnEngineChangePath" Content="변경..." Width="80" Height="24" Margin="8,0,0,0"
                                            Click="BtnEngineChangePath_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="InstallRoot:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbEngineInstallRoot" Width="610" Height="24" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- 서버/로컬 상태 -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="서버 최신 Installed Build" Grid.Column="0" Margin="0,0,6,0">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TxtEngineServerInfo" TextWrapping="Wrap" />
                                    <Button x:Name="BtnEngineRefresh" Grid.Row="1" Content="새로고침" Width="100" Height="26" Margin="0,8,0,0"
                                            Click="BtnEngineRefresh_Click"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="로컬 Installed Build 상태" Grid.Column="1" Margin="6,0,0,0">
                                <Grid Margin="10">
                                    <TextBlock x:Name="TxtEngineLocalInfo" TextWrapping="Wrap"/>
                                </Grid>
                            </GroupBox>
                        </Grid>

                        <!-- 작업 버튼 + 진행 -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnEngineDownload" Content="다운로드" Width="110" Height="28"
                                    Click="BtnEngineDownload_Click"/>
                            <Button x:Name="BtnEngineDownloadInstall" Content="다운로드 + 설치" Width="140" Height="28" Margin="8,0,0,0"
                                    Click="BtnEngineDownloadInstall_Click"/>
                            <ProgressBar x:Name="PbEngine" Width="240" Height="18" Margin="16,4,0,0"/>
                            <TextBlock x:Name="TxtEngineProgress" Margin="8,4,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 로그 -->
                        <TextBox x:Name="TxtEngineLog"
                                Grid.Row="4"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                AcceptsReturn="True"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 1) Setup_p4 -->
            <TabItem Header="Setup p4">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Perforce 환경변수 설정 (setup_p4)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Workspace(P4CLIENT):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TbP4Workspace"
                                 Width="260"
                                 Height="24"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <Button x:Name="BtnSetupP4Apply"
                                Content="적용"
                                Width="80"
                                Height="24"
                                Click="BtnSetupP4Apply_Click"/>
                    </StackPanel>

                    <!-- P4USER 선택 (단일 선택 체크박스) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="P4USER:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="CbP4UserDeveloper"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Click="CbP4UserDeveloper_Click">
                            <TextBlock Text="gw_developer"/>
                        </CheckBox>

                        <CheckBox x:Name="CbP4UserEngine"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Click="CbP4UserEngine_Click">
                            <TextBlock Text="gw_engine"/>
                        </CheckBox>

                        <CheckBox x:Name="CbP4UserGuest"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Click="CbP4UserGuest_Click">
                            <TextBlock Text="gw_guest"/>
                        </CheckBox>
                        </StackPanel>

                    <!-- 탭별 로그: Setup p4 -->
                    <TextBox x:Name="TxtSetupP4Log"
                             Grid.Row="3"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Grid>
            </TabItem>

            <!-- 2) p4_sync  -->
            <TabItem Header="p4 sync">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상단: WS/Root 표시 + 버튼 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Workspace -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Workspace(P4CLIENT)"
                                    VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbP4SyncWorkspace"
                                    IsReadOnly="True" Height="24"/>

                            <!-- Client Root -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Client Root"
                                    VerticalAlignment="Center" Margin="0,6,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbP4SyncClientRoot"
                                    IsReadOnly="True" Margin="0,6,0,0" Height="24"/>

                            <!-- Stream -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Stream"
                                    VerticalAlignment="Center" Margin="0,6,10,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbP4SyncStream"
                                    IsReadOnly="True" Margin="0,6,0,0" Height="24"/>

                            <!-- Local CL -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Local CL"
                                    VerticalAlignment="Center" Margin="0,10,10,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbP4SyncLocalCL"
                                    IsReadOnly="True" Margin="0,10,0,0" Height="24"/>

                            <!-- GW_ProjectBuild CL -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="GW_ProjectBuild CL"
                                    VerticalAlignment="Center" Margin="0,6,10,0"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TbP4SyncBuildCL"
                                    IsReadOnly="True" Margin="0,6,0,0" Height="24"/>

                            <!-- Sync 필요여부 (색상 표시기 + 메시지, statusKind=3일 때 두 줄 표시) -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Sync 필요여부"
                                    VerticalAlignment="Top" Margin="0,10,10,0"/>
                            <Grid Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" MinHeight="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="P4SyncStatusIndicator" Grid.Column="0" Width="12" Height="12" Margin="0,2,8,0"
                                         VerticalAlignment="Top" Fill="Gray"/>
                                <TextBox x:Name="TbP4SyncNeedSync" Grid.Column="1"
                                    IsReadOnly="True" MinHeight="24" Height="40"
                                    TextWrapping="Wrap" VerticalContentAlignment="Top"
                                    VerticalAlignment="Stretch"/>
                            </Grid>
                        </Grid>


                        <Button Grid.Column="2"
                                x:Name="BtnP4SyncRefresh"
                                Content="새로고침"
                                Width="90"
                                Margin="10,0,0,0"
                                Click="BtnP4SyncRefresh_Click"/>

                        <Button Grid.Column="3"
                                x:Name="BtnP4SyncRun"
                                Content="Sync"
                                Width="80"
                                Margin="8,0,0,0"
                                Click="BtnP4SyncRun_Click"/>
                    </Grid>

                    <!-- 탭별 로그 -->
                    <TextBox x:Name="TxtP4SyncLog"
                            Grid.Row="2"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            AcceptsReturn="True"/>
                </Grid>
            </TabItem>

            <!-- 3) GWEditor -->
            <TabItem Header="GWEditor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상단: WS/Project/Editor + Sync 필요여부 + 버튼 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="Workspace(P4CLIENT)" />
                            <TextBlock Text="Project (.uproject)" Margin="0,6,0,0"/>
                            <TextBlock Text="Editor (UnrealEditor.exe)" Margin="0,6,0,0"/>
                            <TextBlock Text="Sync 필요여부" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBox x:Name="TbGWEditorWorkspace" IsReadOnly="True" />
                            <TextBox x:Name="TbGWEditorProjectPath" IsReadOnly="True" Margin="0,6,0,0"/>
                            <TextBox x:Name="TbGWEditorEditorExe" IsReadOnly="True" Margin="0,6,0,0"/>
                            <Grid Margin="0,6,0,0" MinHeight="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="GWEditorSyncStatusIndicator" Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="Gray"/>
                                <TextBox x:Name="TbGWEditorSyncStatus" Grid.Column="1"
                                    IsReadOnly="True" MinHeight="24" Height="40"
                                    TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="BtnGWEditorRefresh"
                                Content="새로고침"
                                Width="90"
                                Margin="10,0,0,0"
                                Click="BtnGWEditorRefresh_Click"/>

                        <Button Grid.Column="3"
                                x:Name="BtnRunGWEditor"
                                Content="실행"
                                Width="80"
                                Margin="8,0,0,0"
                                Click="BtnRunGWEditor_Click"/>
                    </Grid>

                    <!-- 실행 옵션 (에디터 실행 인자) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="실행 옵션:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TbGWEditorArgs" Height="24" VerticalContentAlignment="Center"
                                 Text="-nocompile" MinWidth="280"/>
                        <Button x:Name="BtnGWEditorArgsReset" Content="Reset" Width="60" Height="24" Margin="8,0,0,0"
                                Click="BtnGWEditorArgsReset_Click"/>
                    </StackPanel>

                    <!-- 탭별 로그 -->
                    <TextBox x:Name="TxtGWEditorLog"
                            Grid.Row="2"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            AcceptsReturn="True"/>
                </Grid>
            </TabItem>


            <!-- 4) GameStarter (v2 UI 그대로 유지) -->
            <TabItem Header="GameStarter">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 상단 컨트롤 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,8,10,4">
                        <TextBlock Text="빌드 타입:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbBuildType"
                                  Width="130"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Development" />
                            <ComboBoxItem Content="Shipping" />
                        </ComboBox>

                        <TextBlock Width="20" />

                        <Button x:Name="BtnRefreshFromServer"
                                Content="빌드목록 새로고침"
                                Width="140"
                                Margin="0,0,8,0"
                                Click="BtnRefreshFromServer_Click" />

                        <Button x:Name="BtnRun"
                                Content="게임 실행"
                                Width="80"
                                Margin="0,0,8,0"
                                Click="BtnRun_Click" />

                        <CheckBox x:Name="CbWindowed"
                                  Content="창모드"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />

                        <!-- 구분선 -->
                        <TextBlock Text="│"
                                VerticalAlignment="Center"
                                Margin="4,0,4,0" />

                        <!-- 실행 대상: 클라이언트 / DS -->
                        <CheckBox x:Name="CbRunClient"
                                  Content="클라이언트"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <CheckBox x:Name="CbRunDS"
                                  Content="DS"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- 다운로드/설치 진행율 (Engine 탭과 동일한 방식) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,4">
                        <TextBlock Text="진행율:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ProgressBar x:Name="PbGameStarter" Width="240" Height="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtGameStarterProgress" VerticalAlignment="Center" MinWidth="120"/>
                    </StackPanel>

                    <!-- 실행 옵션 (게임 실행 인자) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,4">
                        <TextBlock Text="실행 옵션:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TbGameStarterArgs" Height="24" VerticalContentAlignment="Center"
                                 Text="-log -LogCmds=&quot;Global Verbose&quot;" MinWidth="320"/>
                        <Button x:Name="BtnGameStarterArgsReset" Content="Reset" Width="60" Height="24" Margin="8,0,0,0"
                                Click="BtnGameStarterArgsReset_Click"/>
                    </StackPanel>

                    <!-- 캐시 경로 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="10,0,10,4">
                        <TextBlock Text="로컬 캐시 경로:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtCachePath"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="BtnChangeCachePath" Content="캐시 경로 변경" Width="120" Height="24" Margin="12,0,0,0"
                                Click="MenuChangeCachePath_Click"/>
                        <Button x:Name="BtnClearCache" Content="캐시 삭제" Width="90" Height="24" Margin="8,0,0,0"
                                Click="MenuClearCache_Click"/>
                        <Button x:Name="BtnOpenCachePath" Content="바로가기" Width="70" Height="24" Margin="8,0,0,0"
                                Click="BtnOpenCachePath_Click"/>
                    </StackPanel>

                    <!-- 빌드 리스트: 체크박스 선택 컬럼 + v2 최종 컬럼 -->
                    <ListView x:Name="LvBuilds"
                              Grid.Row="4"
                              Margin="10,0,10,4"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>

                                <!-- v2 방식: 체크박스가 ListViewItem.IsSelected에 바인딩 -->
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                                          Path=IsSelected,
                                                                          Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="BuildNo."
                                                Width="80"
                                                DisplayMemberBinding="{Binding BuildNo}" />
                                <GridViewColumn Header="Version"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Version}" />
                                <GridViewColumn Header="CL"
                                                Width="80"
                                                DisplayMemberBinding="{Binding CL}" />
                                <GridViewColumn Header="Config"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Config}" />
                                <GridViewColumn Header="Date"
                                                Width="120"
                                                DisplayMemberBinding="{Binding BuildDate}" />
                                <GridViewColumn Header="Time"
                                                Width="100"
                                                DisplayMemberBinding="{Binding BuildTime}" />
                                <GridViewColumn Header="DS"
                                                Width="50"
                                                DisplayMemberBinding="{Binding DS}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 로그: GameStarter -->
                    <TextBox x:Name="TxtLog"
                             Grid.Row="5"
                             Margin="10,0,10,10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
