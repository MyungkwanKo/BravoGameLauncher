<Window x:Class="BravoGameLauncherGui.P4WorkspaceLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="워크스페이스 조회"
        Height="380"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtContext"
                   Grid.Row="0"
                   Margin="0,0,0,8"
                   FontSize="12"
                   Foreground="Gray"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="1">
            <ListBox x:Name="LbWorkspaces"
                     BorderThickness="1"
                     BorderBrush="#DDDDDD"
                     MouseDoubleClick="LbWorkspaces_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,4">
                            <TextBlock Text="{Binding Client}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Root}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TxtEmpty"
                       Text="조회된 워크스페이스가 없습니다."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="BtnClose" Content="닫기" Width="80" Height="26" Margin="0,0,8,0" Click="BtnClose_Click"/>
            <Button x:Name="BtnConfirm" Content="확인" Width="80" Height="26" Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
