<Window x:Class="BravoGameLauncherGui.CrashReportGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="크래시 로그 전송"
        Height="400"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtStatus"
                   Grid.Row="0"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"
                   Text="1. Slack 메시지 입력창을 클릭하고 Ctrl+V 를 누르면 zip이 첨부됩니다.&#x0a;2. 메시지가 함께 붙지 않았다면 아래 [메시지 복사]를 누른 뒤 입력창에서 다시 Ctrl+V 하세요.&#x0a;3. Enter 로 전송합니다."/>

        <TextBlock Grid.Row="2"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="0,0,0,8"
                   Text="[메시지 복사]를 누르면 클립보드가 텍스트로 바뀝니다. 파일을 다시 붙여넣으려면 [파일 다시 복사]를 눌러주세요."
                   TextWrapping="Wrap"/>

        <TextBox x:Name="TbMessage"
                 Grid.Row="3"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#F7F7F7"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4"
                   Text="zip 파일 경로"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="0,0,0,2"/>

        <TextBox x:Name="TbZipPath"
                 Grid.Row="5"
                 IsReadOnly="True"
                 Background="#F7F7F7"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="TxtHint"
                   Grid.Row="6"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="BtnOpenChannel"
                    Content="채널 열기(웹)"
                    Width="110"
                    Height="26"
                    Margin="0,0,8,0"
                    Click="BtnOpenChannel_Click"/>
            <Button x:Name="BtnCopyFile"
                    Content="파일 다시 복사"
                    Width="110"
                    Height="26"
                    Margin="0,0,8,0"
                    Click="BtnCopyFile_Click"/>
            <Button x:Name="BtnCopyMessage"
                    Content="메시지 복사"
                    Width="100"
                    Height="26"
                    Margin="0,0,8,0"
                    Click="BtnCopyMessage_Click"/>
            <Button x:Name="BtnOpenFolder"
                    Content="폴더 열기"
                    Width="90"
                    Height="26"
                    Margin="0,0,8,0"
                    Click="BtnOpenFolder_Click"/>
            <Button x:Name="BtnClose"
                    Content="닫기"
                    Width="80"
                    Height="26"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
