<Window x:Class="BravoGameLauncherGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BravoGameLauncherGui"
        Title="{x:Static local:LauncherVersionInfo.WindowTitle}"
        Height="450"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- 메뉴 -->
            <RowDefinition Height="Auto" />
            <!-- 빌드 타입 + 버튼 -->
            <RowDefinition Height="Auto" />
            <!-- 캐시 경로 -->
            <RowDefinition Height="Auto" />
            <!-- 빌드 리스트 -->
            <RowDefinition Height="*" />
            <!-- 로그 창 -->
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- 메뉴 -->
        <Menu Grid.Row="0">
            <MenuItem Header="_파일">
                <MenuItem Header="캐시 경로 변경..." Click="MenuChangeCachePath_Click" />
                <MenuItem Header="캐시 삭제" Click="MenuClearCache_Click" />
                <Separator />
                <MenuItem Header="종료" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="_서버">
                <MenuItem Header="빌드 목록 새로고침" Click="BtnRefreshFromServer_Click" />
            </MenuItem>
        </Menu>

        <!-- 빌드 타입 + 버튼 + DS 다운로드 -->
        <Grid Grid.Row="1" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- 왼쪽: 기존 컨트롤 -->
                <ColumnDefinition Width="*" />     <!-- 가운데 여백 -->
                <ColumnDefinition Width="Auto" />  <!-- 오른쪽: DS 다운로드 -->
            </Grid.ColumnDefinitions>

            <!-- [좌측] 빌드 타입 / 새로고침 / 실행 / 창모드 / Local / Server -->
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <!-- 빌드 타입 -->
                <TextBlock Text="빌드 타입:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbBuildType"
                          Width="130"
                          SelectedIndex="0"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="Development" />
                    <ComboBoxItem Content="Shipping" />
                </ComboBox>

                <TextBlock Width="20" />

                <!-- 빌드 목록 새로고침 -->
                <Button x:Name="BtnRefreshFromServer"
                        Content="빌드목록 새로고침"
                        Width="140"
                        Margin="0,0,8,0"
                        Click="BtnRefreshFromServer_Click" />

                <!-- 실행 -->
                <Button x:Name="BtnRun"
                        Content="실행"
                        Width="80"
                        Margin="0,0,8,0"
                        Click="BtnRun_Click" />

                <!-- 창모드 체크 -->
                <CheckBox x:Name="CbWindowed"
                          Content="창모드"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />

                <!-- 구분선 -->
                <TextBlock Text="│"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0" />

                <!-- Local / Server 선택 -->
                <CheckBox x:Name="CbLocal"
                          Content="Local"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"
                          Click="CbLocal_Click" />
                <CheckBox x:Name="CbServer"
                          Content="Server"
                          VerticalAlignment="Center"
                          Click="CbServer_Click" />
            </StackPanel>

            <!-- [우측] Dedicated Server 테스트용 다운로드 버튼 -->
            <Button x:Name="BtnDownloadDsSample"
                    Grid.Column="2"
                    Content="DS 다운로드"
                    Width="110"
                    HorizontalAlignment="Right"
                    Click="BtnDownloadDsSample_Click" />
        </Grid>


        <!-- 캐시 경로 -->
        <DockPanel Grid.Row="2" Margin="10,0,10,5">
            <TextBlock Text="캐시 경로:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0" />
            <TextBox x:Name="TxtCachePath"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0" />
        </DockPanel>

        <!-- 빌드 리스트 (체크박스 + 버전/CL/Config/Date/Time) -->
        <ListView x:Name="LvBuilds"
                  Grid.Row="3"
                  Margin="10,0,10,5"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <!-- 체크박스: ListViewItem.IsSelected 에 바인딩 -->
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                              Path=IsSelected,
                                                              Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="BuildNo."
                                    Width="80"
                                    DisplayMemberBinding="{Binding JenkinsNumber}" />
                    <GridViewColumn Header="Version"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="CL"
                                    Width="80"
                                    DisplayMemberBinding="{Binding CL}" />
                    <GridViewColumn Header="Config"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Config}" />
                    <GridViewColumn Header="Date"
                                    Width="120"
                                    DisplayMemberBinding="{Binding BuildDate}" />
                    <GridViewColumn Header="Time"
                                    Width="100"
                                    DisplayMemberBinding="{Binding BuildTime}" />
                </GridView>
            </ListView.View>
        </ListView>


        <!-- 로그 창 -->
        <TextBox x:Name="TxtLog"
                 Grid.Row="4"
                 Margin="10,0,10,10"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" />
    </Grid>
</Window>
