<Window x:Class="BravoGameLauncherGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bravo Game Launcher"
        Height="450"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- 메뉴 -->
            <RowDefinition Height="Auto" />
            <!-- 빌드 타입 + 버튼 -->
            <RowDefinition Height="Auto" />
            <!-- 캐시 경로 -->
            <RowDefinition Height="Auto" />
            <!-- 빌드 리스트 -->
            <RowDefinition Height="2*" />
            <!-- 로그 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 메뉴 -->
        <Menu Grid.Row="0">
            <MenuItem Header="옵션(_O)">
                <MenuItem Header="캐시 경로 변경..." Click="MenuChangeCachePath_Click" />
                <MenuItem Header="캐시 전체 삭제..." Click="MenuClearCache_Click" />
                <Separator />
                <MenuItem Header="종료(_X)" Click="MenuExit_Click" />
            </MenuItem>
        </Menu>

        <!-- 빌드 타입 + 실행/서버 버튼 -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10,8,10,4">
            <TextBlock Text="빌드 타입:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CmbBuildType"
                      Width="130"
                      SelectedIndex="0"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="Development" />
                <ComboBoxItem Content="Shipping" />
            </ComboBox>

            <TextBlock Width="20" />

            <Button x:Name="BtnRun"
                    Content="실행"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="BtnRun_Click" />

            <Button x:Name="BtnRefreshFromServer"
                    Content="서버 새로고침"
                    Width="120"
                    Click="BtnRefreshFromServer_Click" />
        </StackPanel>

        <!-- 캐시 경로 표시 -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10,0,10,4">
            <TextBlock Text="로컬 캐시 경로:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="TxtCachePath"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 빌드 리스트 (체크박스 + 버전/CL/빌드일자/빌드시간) -->
        <ListView x:Name="LvBuilds"
                  Grid.Row="3"
                  Margin="10,0,10,4"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <!-- 체크박스: ListViewItem.IsSelected 에 바인딩 -->
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                              Path=IsSelected,
                                                              Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- 버전 -->
                    <GridViewColumn Header="버전"
                                    Width="110"
                                    DisplayMemberBinding="{Binding Version}" />

                    <!-- CL -->
                    <GridViewColumn Header="CL"
                                    Width="80"
                                    DisplayMemberBinding="{Binding CL}" />

                    <!-- 빌드일자 -->
                    <GridViewColumn Header="빌드일자"
                                    Width="120"
                                    DisplayMemberBinding="{Binding BuildDate}" />

                    <!-- 빌드시간 -->
                    <GridViewColumn Header="빌드시간"
                                    Width="100"
                                    DisplayMemberBinding="{Binding BuildTime}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 로그 창 -->
        <TextBox x:Name="TxtLog"
                 Grid.Row="4"
                 Margin="10,0,10,10"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" />
    </Grid>
</Window>
