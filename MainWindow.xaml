<Window x:Class="BravoGameLauncherGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bravo Game Launcher" Height="320" Width="780"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- 메뉴 -->
            <RowDefinition Height="Auto" />
            <!-- 파일명 입력 -->
            <RowDefinition Height="Auto" />
            <!-- 캐시 경로 -->
            <RowDefinition Height="Auto" />
            <!-- 로그 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 메뉴 -->
        <Menu Grid.Row="0">
            <MenuItem Header="옵션(_O)">
                <MenuItem Header="캐시 경로 변경..." Click="MenuChangeCachePath_Click" />
                <MenuItem Header="캐시 전체 삭제..." Click="MenuClearCache_Click" />
                <Separator />
                <MenuItem Header="종료(_X)" Click="MenuExit_Click" />
            </MenuItem>
        </Menu>

        <!-- 파일명 입력 줄 -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10,8,10,4">
            <TextBlock Text="빌드 ZIP 파일명:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CmbFileName"
                    Width="420"
                    IsEditable="True"
                    StaysOpenOnEdit="True"
                    IsTextSearchEnabled="False"
                    VerticalAlignment="Center" />
            <Button x:Name="BtnRun"
                    Content="실행"
                    Width="80"
                    Margin="8,0,0,0"
                    Click="BtnRun_Click" />
            <Button x:Name="BtnRefreshFromServer"
                    Content="서버 목록 새로고침"
                    Width="140"
                    Margin="8,0,0,0"
                    Click="BtnRefreshFromServer_Click" />
        </StackPanel>

        <!-- 캐시 경로 표시 -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10,0,10,4">
            <TextBlock Text="로컬 캐시 경로:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="TxtCachePath"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 로그 창 -->
        <TextBox x:Name="TxtLog"
                 Grid.Row="3"
                 Margin="10,0,10,10"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" />
    </Grid>
</Window>
